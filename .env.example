OPENAI_API_KEY= your_openai_api_key_here

# Model used for chat/answer generation
OPENAI_CHAT_MODEL=gpt-4o-mini

# Model used for embeddings (RAG)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# SQLite database path (auto-created)
DATABASE_URL=sqlite:///./data/financial_data.db

# Where FAISS index files are stored
VECTOR_STORE_DIR=./data/vector_store

# Backend URL the Streamlit frontend calls
BACKEND_URL=http://localhost:8000
